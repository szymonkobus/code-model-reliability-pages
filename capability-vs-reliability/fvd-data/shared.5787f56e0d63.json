 "vocab": {
  "reserved": {
   "reliability": "average-rate 1% crossing",
   "capability": "average-rate 50% crossing"
  },
  "top_half": "the top half of the new pool = the focused tasks, cohorts 1 and 2 of the maintainers' frozen membership file (877 at the freeze; in-frame count in the unified stamp's task_tiers block); as adopted of 5 Sep it is plotted because generation is being finished there first, wave 1+2 before wave 2 on its own; a plotted set (dataset switch value top), not a change of the frame or of the fits of record (rule of 3 Sep: fit on all data; tiers are membership labels)",
  "board_plus_top_half": "the board tasks (438) together with the top half of the new pool (the focused cohorts 1 and 2) on one axis, the first plotted set of 2026-09-05 (dataset switch value board_top); the parked half (cohorts 3 and 4) is excluded from this plot and from 'top half by itself', never from the frame; the board is already mostly fitted and offers less variety",
  "task_tier": "",
  "house_bandwidth": "",
  "axis_smoothing": "",
  "curve_of_record": "",
  "curve_of_record_updated": "updated 9 Sep: the clause about fitting's pending export switch retired; axis_smoothing and every other key unchanged",
  "qualified_use": "",
  "enforced": {
   "golden set": "",
   "average-rate 1% crossing": "where the model's fitted average failure rate first reaches 1%",
   "median-task 1% crossing": "where the median task's failure rate reaches 1%",
   "average-rate 50% crossing": "where the fitted average failure rate reaches even odds",
   "median-task 50% crossing": "where the median task reaches even odds",
   "level pair (1%, 50%)": "two linked crossings of one trend, always written with concrete levels — never variables",
   "cumulative 1% failure rate": "the hardest difficulty such that average failure over ALL easier tasks is still ≤ 1%",
   "worst-stretch 1% failure rate": "the same, but EVERY trailing stretch of easier tasks must stay ≤ 1% — easy wins cannot bank budget for later failures",
   "first task above 1% failure": "the last difficulty before the first single task failing more than 1%",
   "cumulative X% failure rate": "the same machine at any other concrete anchor",
   "99%-assured": "prefix: quoted at the value it holds with 99% posterior probability"
  },
  "soft": {
   "success-mass balance point": "everything the model solves, added up and read as one position on the difficulty axis — mean pass rate expressed as a difficulty",
   "contested mass": "how much of the difficulty axis the model SOMETIMES solves and sometimes fails — the width of its struggle zone",
   "easy-success subsidy": ""
  },
  "formerly": {
   "reliable range": "cumulative 1% failure rate",
   "debt-free range": "worst-stretch 1% failure rate",
